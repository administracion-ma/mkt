# ============================================================================
# CoinBox Marketing — variables de entorno
# ============================================================================
# Copiá este archivo a .env.local para desarrollo, y cargá las mismas claves
# (con sus valores reales) en el panel de tu hosting para producción, y como
# "Secrets" en GitHub → Settings → Secrets and variables → Actions (los cron
# jobs en .github/workflows/ corren fuera del hosting y necesitan su propia
# copia de las que usan).

# --- Base de datos (Supabase Postgres) --------------------------------------
# Usar el connection string del POOLER en modo "Transaction" (puerto 6543),
# no el de conexión directa (puerto 5432) — este último se agota rápido con
# varias funciones serverless concurrentes. Se consigue en:
# Supabase → tu proyecto → Connect → ORM → Drizzle → "transaction-mode pooler"
DATABASE_URL=postgresql://user:password@host:6543/postgres

# --- Meta (Instagram) — developers.facebook.com -----------------------------
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Debe coincidir EXACTO con la redirect URI configurada en la app de Meta
META_REDIRECT_URI=https://tu-dominio/api/auth/instagram/callback
META_GRAPH_API_VERSION=v21.0

# --- YouTube (Google Cloud Console — OAuth 2.0 Client) ----------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://tu-dominio/api/auth/youtube/callback

# --- TikTok (developers.tiktok.com) -----------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://tu-dominio/api/auth/tiktok/callback

# --- Kommo (CRM) — Configuración → Integraciones → Integración privada -----
# Token de larga duración (sin flujo OAuth), dura ~1 año.
KOMMO_SUBDOMAIN=
KOMMO_ACCESS_TOKEN=

# --- Subida de archivos grandes (videos de YouTube/TikTok) ------------------
# Hoy usa Vercel Blob — es un producto propio de Vercel, NO funciona en otro
# hosting tal cual está. Ver README.md § "Dependencias específicas de Vercel"
# antes de migrar de plataforma.
BLOB_READ_WRITE_TOKEN=

# --- Seguridad ---------------------------------------------------------------
# Clave para cifrar los tokens de acceso (OAuth) en la base de datos.
# Generar con: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- IA (Anthropic) — para los informes/análisis automáticos ----------------
ANTHROPIC_API_KEY=

# --- Email (opcional) — recordatorios por mail, resend.com ------------------
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
