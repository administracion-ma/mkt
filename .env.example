# Postgres (Supabase) — connection string del pooler (modo "Transaction")
DATABASE_URL=postgresql://user:password@host:5432/postgres

# App de Meta (developers.facebook.com) → Configuración → Básica
META_APP_ID=
META_APP_SECRET=
# Debe coincidir EXACTO con la redirect URI configurada en la app de Meta
META_REDIRECT_URI=https://tu-dominio.vercel.app/api/auth/instagram/callback
META_GRAPH_API_VERSION=v21.0

# Clave para cifrar los tokens de acceso en la base de datos.
# Generar con: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# API de Anthropic, para el botón "Analizar"
ANTHROPIC_API_KEY=
